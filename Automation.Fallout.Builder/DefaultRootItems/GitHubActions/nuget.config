<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="github" value="https://nuget.pkg.github.com/meddlingidiot/index.json" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>

    <!--
      GitHub Packages always requires a token, even for public packages. Any username is accepted
      once the token is valid, so the owner is used rather than a personal handle.
    -->
    <packageSourceCredentials>
        <github>
            <add key="Username" value="meddlingidiot" />
            <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
        </github>
    </packageSourceCredentials>

    <!-- Optional but recommended -->
    <packageSourceMapping>
        <packageSource key="github">
            <package pattern="Automation.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
